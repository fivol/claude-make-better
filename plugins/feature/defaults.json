{
  "mode": "lite",
  "worktrees_dir": "worktrees",
  "max_live_servers": 5,
  "reap_sweep_age": 1800,
  "output_language": "the user's language",
  "instructions": [],
  "considerations": [],
  "branch": {
    "prefix": "task-"
  },
  "simplify": {
    "enabled": true,
    "when": "significant"
  },
  "commit": {
    "per_pass": true,
    "message_language": "en"
  },
  "pr": {
    "enabled": true,
    "draft": false
  },
  "merge": {
    "strategy": "merge",
    "via": "local-push",
    "wait_ci": true,
    "cleanup": true
  },
  "report": {
    "chat_template": null,
    "summary_template": null
  },
  "pr_feedback": {
    "enabled": true,
    "reply": "always",
    "resolve": "never",
    "include_outdated": true,
    "include_bots": false,
    "marker": "<!-- feature:reply -->"
  },
  "code_review": {
    "enabled": true,
    "level": "max",
    "working_level": "medium",
    "fix": true,
    "final_pass": true,
    "final_comment": true,
    "max_finders": 16,
    "max_verifiers": 12,
    "deep_agent_model": "opus",
    "light_agent_model": "sonnet",
    "angles": {
      "disabled": [],
      "extra": []
    }
  },
  "proxy": {
    "enabled": true,
    "domain_suffix": "localhost",
    "admin_host": "admin.localhost",
    "admin_port": 7878
  },
  "repos": []
}
